# ==============================================================================
# WindGuard AI — Environment Configuration Template
# ==============================================================================
# WindGuard AI operates strictly OFFLINE with deterministic local ML and Mode A
# hybrid RAG reasoning. No cloud LLM keys or external API credentials are required.
# ==============================================================================

# Service Networking
API_HOST=127.0.0.1
API_PORT=8000
ENVIRONMENT=production

# Machine Learning & Simulation Configuration
DEFAULT_RANDOM_SEED=42
SAMPLING_INTERVAL_MINUTES=10.0

# Advisory Engine Configuration
DEFAULT_PROVIDER_MODE=MODE_A
DEFAULT_GUARDRAIL_POLICY=STANDARD
